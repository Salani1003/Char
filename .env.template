# En dev, cambiar a True a mano. El default es False para que un .env
# copiado sin pensar no termine sirviendo con DEBUG activo en producción.
DEBUG=False
# Obligatoria. Generar una con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# Credenciales de dev (las usa también docker-compose para crear la base).
# Cambiarlas en cualquier entorno que no sea local.
DB_NAME=char
DB_USER=char_user
DB_PASSWORD=char_password
# localhost para correr Django sin Docker. Dentro de Docker Compose se
# pisa solo a "db", no hace falta tocarlo.
DB_HOST=localhost
# Puerto de Postgres dentro de la red de Docker. Desde tu máquina, el
# contenedor se expone en el 5434 (psql -h localhost -p 5434 ...).
DB_PORT=5432

# Opcionales (tienen default en config/settings.py): ALLOWED_HOSTS,
# CORS_ALLOWED_ORIGINS, EMAIL_BACKEND y, para producción con DEBUG=False,
# SECURE_SSL_REDIRECT, SECURE_HSTS_SECONDS, SECURE_HSTS_INCLUDE_SUBDOMAINS,
# SECURE_HSTS_PRELOAD y CSRF_TRUSTED_ORIGINS.
